{
  "name": "crypto-trading-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Crypto Trading System",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "telegram-bot-api": "^0.61.5",
    "binance-api-node": "^0.12.5",
    "coinbase-pro": "^3.2.0",
    "ccxt": "^4.1.0",
    "technicalindicators": "^3.1.0",
    "ml-matrix": "^6.10.4",
    "tensorflow": "^4.10.0",
    "stripe": "^14.0.0",
    "cors": "^2.8.5",
    "axios": "^1.6.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
